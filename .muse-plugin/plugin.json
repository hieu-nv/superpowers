{
  "schemaVersion": 1,
  "name": "superpowers",
  "displayName": "Superpowers",
  "version": "7.0.2",
  "description": "Core skills library for Muse: TDD, debugging, collaboration patterns, and proven techniques",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "code-medic",
        "path": "skills/code-medic/SKILL.md"
      },
      {
        "id": "commit",
        "path": "skills/commit/SKILL.md"
      },
      {
        "id": "sync",
        "path": "skills/sync/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "bash",
          "hooks/session-start"
        ],
        "timeoutMs": 5000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
